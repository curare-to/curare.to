{
  "name": "curare-to",
  "version": "0.1.0",
  "private": true,
  "description": "A decentralized reddit on curated lists: subreddits are kind 31889 schema events, posts are kind 31890 canonical events, read from Nostr relays in the browser.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "serve": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "NEXT_PUBLIC_DIRECTORY_RELAYS=ws://localhost:10547 npm run build && playwright test",
    "e2e:only": "playwright test",
    "e2e:single": "NEXT_PUBLIC_DIRECTORY_RELAYS=ws://localhost:10547 NEXT_PUBLIC_SINGLE_LIST=/.well-known/curare.to/nostr.json npm run build && SINGLE=1 playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "next": "^15.1.0",
    "nostr-tools": "^2.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
